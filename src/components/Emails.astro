---
const examples = ["name@gmail.com", "name@yahoo.com", "name@outlook.com"]
---

<fieldset class="box-shadow " id="Emails" >
    <legend class="HStack x-stretch">

        Emails / Aliases 

        <div style="flex:1;"></div>
        <menu class="menu-horizontal" style="font-size: var(--font-sm4); width: initial;">

            <li>
                <button class="not-prose" id="Email-dialog-trigger"> 
                    <span class="icon" style="--icon-url:var(--icon-plus); pointer-events: none; display: block;" ></span>
                </button>
            </li>

            <li>
                <label 
                for="Email-edit" 
                id="Email-edit-label" 
                style="width: fit-content;"
                class="ZStack not-prose"></label>

                <input type="checkbox" id="Email-edit" class="hide-checkbox" >
            </li>

        </menu>
    </legend>


    <menu id="Email-list" 
        style="background: transparent; 
        border-radius: 0;
        max-height: var(--size-xl1); 
        transition: max-height .3s var(--move);
        margin-bottom: var(--size-sm4);
        overflow-y: scroll;
        overflow-x: hidden;
        touch-action: manipulation;">

        {examples.map((item) => (

            <li style="width:100%;background-color:transparent;padding-inline:0;">
                <div>
                    <button 
                    class="not-prose shiny-text" 
                    style="text-align:start;
                    font-weight: 600;">
                    {item} </button>
                    
                </div>
            </li>

        ))}
    </menu>

</fieldset>

<dialog id="Email-dialog">
    <form method="dialog">

        <h3 style="margin-top: 0;">Add Emails / Aliases</h3>

        <input
            autocomplete="off"
            id="Email-input"
            type="text"
            style="width: 100%;"
            placeholder="Email" />


        <div class="HStack" style="margin-top:var(--size-sm3);">
            <button class="not-prose x-stretch" >Cancel</button>
            <button class="x-stretch" id="Email-add" disabled > Add</button>
        </div>

    </form>
</dialog>




<script>
import { render } from "solid-js/web"
import { email } from '../logic/email'
import { createSwapy } from 'swapy'
import { dbUpdate, toRecordId } from "../utils/surrealdb-indexed";
import EmailsList from './Emails'
import { initSwiper } from "./ui/swiper.ts";



document.getElementById("Email-dialog")!.addEventListener("input",(e)=>{
    if((e!.target as HTMLInputElement).matches("#Email-input")){
       const value = (e!.target as HTMLInputElement).value;
       email.setEmailInput(value.toString());
       if(email.get("emailInput") === "") {
        (document.getElementById("Email-add")! as HTMLInputElement).disabled  = true;  
         } else {
        (document.getElementById("Email-add")! as HTMLInputElement).disabled  = false; 
     } 
    }
});

document.getElementById("Email-dialog")!.addEventListener("click",(e)=>{
    if ((e!.target as HTMLInputElement).matches("#Email-add")) { 
        email.addEmail(email.get("emailInput"))
    }
});

document.getElementById("Emails")!.addEventListener("click", (e) => {
    if ((e!.target as HTMLButtonElement).matches("#Email-dialog-trigger")) { 
        (document.getElementById("Email-dialog") as HTMLDialogElement).showModal();
    }
});

document.getElementById("Emails")!.addEventListener("change",(e)=>{
    if((e!.target as HTMLInputElement).matches("#Email-edit")){
        email.setIsEditing((e!.target as HTMLInputElement).checked)
    };
});

const container = document.getElementById("Email-list")  as HTMLElement

const swapy = createSwapy(container, {
    animation: 'dynamic',
    autoScrollOnDrag: true,
});

swapy.enable(false);

initSwiper(container);

let dispose: () => void

email.on(["emailList"], ({value}) => {
    email.setEmailInput("");
    (document.getElementById("Email-input") as HTMLInputElement).value = "";
    (document.getElementById("Email-add")   as HTMLInputElement).disabled = true;
    container.textContent = "";
    dispose?.();

    dispose = render(
        () => EmailsList( 
                (value ?? []).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()),
                email.get("isEditing")
            ),
            container
        )
   
    swapy.update()

});



email.on(["isEditing"], ({value}) =>{ 

    container.style.maxHeight = value ? "var(--size-xl5)" : "var(--size-xl1)"
    swapy.enable(value);

    container.textContent = "";
    dispose?.();

    dispose = render(
        () => EmailsList( 
                (email.get("emailList")?? []).sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()),
                value
            ),
            container
        )

    swapy.update()
})


swapy.onSwapEnd((event) => {
    event.slotItemMap.asArray.forEach((item) =>{(async () => {
        const emailId = toRecordId(item.item, "Emails");
        if (!emailId) {return}
            await dbUpdate("Emails:update",{id:emailId, createdAt:item.slot}); 
        })();      
    })
    email.updateEmailList();
})

email.updateEmailList();

</script>

<style is:global>


#Email-list:has(> li)::after {
  content: 'tap on email to copy';
  position: absolute;
  bottom: var(--size-sm4);
  left: var(--size-sm4);
  font-size: var(--font-sm4);
  color: oklch(var(--gray-50) / 1);
}

#Email-edit-label::before{
    content: '';
    mask: var(--icon-edit) no-repeat center;
    background-color: oklch(var(--gray-95) ); 
    width: var(--size-sm3);
    height: var(--size-sm3);
}

:root:has(#Email-edit:checked) #Email-edit-label::before{
    mask: var(--icon-check) no-repeat center;
}

@keyframes slide-in-right {
  from {
    transform: translateX(var(--size-sm0));
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.slide-in-right {
  animation: slide-in-right 0.15s var(--appear) forwards;
}


</style>