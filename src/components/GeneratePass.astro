---
import Tabs from '../components/ui/Tabs';
import Popover from '../components/ui/Popover'
import CharactersCount from '../components/CharactersCount.astro';
import CharactersPattern from '../components/CharactersPattern.astro'; 
import TempList from '../components/TempList.astro';
import {icons} from '../utils/icons'
---

<fieldset class="box-shadow" style="color: oklch(var(--gray-95));" id="GeneratePass">
    <legend class="HStack x-stretch">

        Password
        
        <div style="flex:1;"></div>
        <menu class="menu-horizontal" style="font-size: var(--font-sm4); width: initial;">

            <li>
                <button id="GeneratePass-copy-hint" class="not-prose blink" >
                    <span class="icon" style={{'--icon-url':icons.copy, 'pointer-events': "none", "display": "block"}}></span>
                </button>
            </li>

            <li>
                <div>
                    <TempList />  
                </div>
            </li>

            <li>

                <Popover>
                    <fragment slot="trigger"> 
                     
                    <div id="GeneratePass-encrypted-icon" class="ZStack blink" >          
                        <span class="icon" style="--icon-url:var(--icon-dots); pointer-events: none;"></span>
                    </div> 

                    </fragment>

                    <menu id="GeneratePass-encrypted"  class="glass VStack leading" style=" --gap:0;
                    width: var(--size-xl3);
                    font-size: var(--size-sm1);
                    line-height: var(--size-sm4);" >

                        <div style="padding :var(--padding-3); padding-block-end: 0;" >Encrypted password :</div>
                        <div id="GeneratePass-encrypted-pass" class="ellipsis" style="padding :var(--padding-3); padding-block-start: 0;">
                            <div style="width: unset;" class="skeleton"></div>
                        </div>
                        
                        <li>
                            <button id="GeneratePass-encrypted-pass-copy" class="not-prose HStack no-select">
                                <span class="icon" style={{"--icon-url": icons.copy, "pointer-events": "none"}}></span>
                                <div style="pointer-events: none;" > Copy </div> 
                            </button>
                        </li>   
                    </menu>
                </Popover>
            </li>
        </menu>
    </legend>
    <Tabs tab1Label="Random" tab1Value="rPassword" tab2Label="Manual" tab2Value="mPassword" >

        <fragment slot="tab1">

            <div class="HStack not-prose " style="margin-top: var(--size-sm4); ">

                <div 
                id="GeneratePass-r-password" 
                class="text-as-button"
                style="font-weight: 700;
                height: unset;
                cursor: pointer;">                    
                    <div class="skeleton" style="width:var(--size-xl1)"> </div>
                </div>

                <div style="flex:1;"></div>
        
                    <button 
                        style="margin-right: calc(var(--size-sm0) * -1);"
                        id="GeneratePass-redo" 
                        name="regenerate password" 
                        class="text-as-button blink">   

                        <span class="icon" style="--icon-url:var(--icon-redo); pointer-events: none; display: block;"></span>
                    </button>                    


            </div>


            <CharactersCount />
            <CharactersPattern />

        </fragment>

        <fragment slot="tab2">
            <div 
                class=" prose" 
                style="display: flex;
                gap: var(--size-sm0);
                justify-content: space-between;
                margin: var(--size-md1) 0 0">

                <input 
                    autocomplete="off" 
                    id="GeneratePass-m-input" 
                    type="text" 
                    placeholder="Password">

            </div>
        </fragment>
    </Tabs>

    <div class="HStack" 
    style="margin-top: var(--size-sm4);
    margin-bottom: var(--size-sm0);">


        <div id="GeneratePass-led-div" class=" blink" style="align-self: flex-start; margin-block-start: var(--size-xs1);" >
            <span id="GeneratePass-led" class="icon" 
            style="display: block;
            --icon-url:var(--icon-info);
            --led-color: oklch(var(--warning));
            filter: drop-shadow(0px 0px 7px var(--led-color));
            background-color: var(--led-color); "></span>

        </div>  

        <small 
            id="GeneratePass-strength" 
            class="skeleton-parrent x-stretch " 
            style="display: grid;">

            <div style="width: var(--size-xl4);" class="skeleton"> </div>
            <div style="width: var(--size-xl3);" class="skeleton"> </div>
            <div style="width: var(--size-xl2);" class="skeleton"> </div>
        </small>  


    </div>

</fieldset>

<script>
  
import { pass } from '../logic/pass';
import { showToast } from "../components/ui/toast.ts";


document.getElementById("GeneratePass")!.addEventListener("change",(e)=>{
    const { checked, dataset:{value}} = e.target as HTMLInputElement

    if ( !checked || !value) return
    if (value !== "mPassword" && value !== "rPassword") return;

    pass.setPassword(pass.get(value));

});


pass.on(["rPassword"], ({value}) => { document.getElementById("GeneratePass-r-password")!.textContent = value;});


["GeneratePass-redo","GeneratePass-copy-hint", "GeneratePass-encrypted-icon"].forEach(id =>
    document.getElementById(id)?.classList.remove('blink'));

document.getElementById("GeneratePass")!.addEventListener("click",(e)=>{
   if((e!.target as HTMLInputElement).matches("#GeneratePass-copy-hint , #GeneratePass-r-password")){
      navigator.clipboard.writeText(pass.get("Password"));  
      showToast(pass.get("Password")); 
   }

  if((e!.target as HTMLInputElement).matches("#GeneratePass-redo")){
    pass.updateRPassword();
  }
});

// manual password input
document.getElementById("GeneratePass")!.addEventListener("input",(e)=>{
    if((e!.target as HTMLInputElement).matches("#GeneratePass-m-input")){
      const value = (e!.target as HTMLInputElement).value;
      pass.setMPassword(value);
    }
});

document.getElementById("GeneratePass-led-div")!.classList.remove('blink');

pass.on(['strength'], ({value}) =>{
  
    document.getElementById("GeneratePass-led")!.style.setProperty("--led-color", 
        value.includes("Zxcvbn") ? "oklch( 100% 0 0)"  :
        value.includes("day")    ? "oklch(var(--warning))" :
        value.includes("month")  ? "oklch(var(--success))" :
        value.includes("year")   ? "oklch(var(--primary))" : "oklch(var(--danger))"
    );
})

pass.on(['strength'], ({ value }) => {
    const strength = document.getElementById("GeneratePass-strength")  as HTMLElement;

    strength.textContent = '';
    strength.style.display = "block";

    if (value !== "Zxcvbn cannot evaluate a blank password") {

      strength.appendChild(
        document.createTextNode('With an offline attack rate of one billion guesses per second, this password would take an estimated ')
      );

      const u = document.createElement('u');
      u.textContent = value;
      strength.appendChild(u);

      strength.appendChild(
        document.createTextNode(' to compromise.')
      );

    } else {
      strength.textContent = value;
    }
});

pass.on(["encryptedPass", "keyIvIsValid"], pl => {
        const encryptedPass = document.getElementById("GeneratePass-encrypted-pass")  as HTMLButtonElement;
        const encryptedPassCopy = document.getElementById("GeneratePass-encrypted-pass-copy")  as HTMLButtonElement;

    
        encryptedPass.textContent = pass.get("encryptedPass");

        if(pass.get("encryptedPass") !== "" && pass.get("keyIvIsValid") === true) {
            encryptedPass.disabled  = false;
            encryptedPassCopy.disabled  = false;
        } else {
            encryptedPass.disabled  = true;
            encryptedPassCopy.disabled  = true;
        }
});


//copy Encrypted Pasword

const encryptedPass = document.getElementById("GeneratePass-encrypted")  as HTMLElement;

encryptedPass.addEventListener("click",(e)=>{
    if((e!.target as HTMLInputElement).matches("#GeneratePass-encrypted-pass-copy, #GeneratePass-encrypted-pass-copy-li")){
        if(pass.get("encryptedPass") !== "" && pass.get("keyIvIsValid") === true) {
            navigator.clipboard.writeText(pass.get("encryptedPass"));  
            showToast(pass.get("encryptedPass")); 
        } 
    };
});



pass.updateRPassword();
</script>